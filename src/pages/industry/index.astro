---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
import {
  industryEducation,
  industryExperience,
  industryLearningIntro,
  industryProfile,
  industryProjects,
  industrySkills,
  keyFigures,
} from '../../data/industry';
import '../../styles/site.css';

const description =
  'Machine learning research engineer (MSc EPFL). Research internships at Nokia Bell Labs (focus-map prediction for cloud gaming) and Apple (formal verification of hardware). Deep learning, computer vision, reinforcement learning.';
---

<BaseLayout
  title="Farès Zaghouane — Machine Learning Research Engineer"
  path="/industry/"
  description={description}
  knowsAbout={['Deep learning', 'Computer vision', 'Reinforcement learning', 'World models', 'Self-supervised learning', 'Formal verification']}
>
  <main class="site-shell">
    <header class="hero">
      <nav class="top-nav" aria-label="Primary navigation">
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="hero-grid">
        <div>
          <h1>{profile.name}</h1>
          <p class="role-line">{profile.role} <span aria-hidden="true">·</span> <span class="credential">{profile.credential}</span></p>
          <p class="lead">{industryProfile.headline}</p>
          <p class="summary" set:html={industryProfile.summary} />
          <div class="hero-actions" aria-label="Profile links">
            <a class="button primary" href={industryProfile.resume}>Resume</a>
            <a class="button" href={`mailto:${profile.email}`}>Email me</a>
          </div>
        </div>
        <aside class="profile-card" aria-label="Contact details">
          <dl>
            <div>
              <dt>Location</dt>
              <dd>{profile.location}</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${profile.email}`} aria-label={`Email ${profile.name}`}>{profile.displayEmail}</a></dd>
            </div>
            <div>
              <dt>GitHub</dt>
              <dd><a href={profile.github}>github.com/faresZzz</a></dd>
            </div>
            <div>
              <dt>LinkedIn</dt>
              <dd><a href={profile.linkedin}>linkedin.com/in/fares-zaghouane</a></dd>
            </div>
            <div>
              <dt>Languages</dt>
              <dd>{profile.languages.join(' · ')}</dd>
            </div>
          </dl>
          <p class="looking-for">{industryProfile.lookingFor}</p>
        </aside>
      </div>

      <ul class="key-figures" aria-label="Key figures">
        {keyFigures.map((figure) => (
          <li>
            <strong>{figure.value}</strong>
            <span>{figure.label}</span>
          </li>
        ))}
      </ul>
    </header>

    <section id="experience" class="section split-section">
      <div class="section-heading">
        <p class="eyebrow">Experience</p>
        <h2>Industrial research</h2>
      </div>
      <div class="timeline">
        {industryExperience.map((item) => (
          <article class="timeline-item">
            <p class="period">{item.period}</p>
            <h3>{item.role}</h3>
            <p class="meta"><strong>{item.company}</strong> · {item.location}</p>
            <p class="plain-terms"><span>In plain terms</span>{item.plain}</p>
            <ul>
              {item.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            <p class="team-line">{item.team}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="section">
      <div class="section-heading wide">
        <p class="eyebrow">Selected projects</p>
        <h2>What I build on my own</h2>
        <p>{industryLearningIntro} The code is public. The two research projects are still in progress, and their pages say so.</p>
      </div>
      <div class="project-grid">
        {industryProjects.map((project) => (
          <a class="project-card project-card-link" href={project.link} aria-label={`Open ${project.title} GitHub repository`}>
            <div class="card-topline">
              <h3>{project.title}</h3>
              <strong class={`status-badge ${project.status === 'Public' ? 'is-public' : 'is-quiet'}`}>{project.status}</strong>
            </div>
            <p class="project-plain">{project.plain}</p>
            <p class="project-result">{project.result}</p>
            <div class="stack">
              {project.stack.map((item) => <span>{item}</span>)}
            </div>
            <span class="text-link">View repository &rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <section id="skills" class="section skills-section">
      <div>
        <p class="eyebrow">Skills</p>
        <h2>Toolkit</h2>
      </div>
      <div class="toolkit-list">
        {industrySkills.map((group) => (
          <div class="toolkit-row">
            <h3>{group.category}</h3>
            <div class="tag-list">
              {group.items.map((skill) => <span>{skill}</span>)}
            </div>
          </div>
        ))}
        <div class="toolkit-row">
          <h3>Languages</h3>
          <div class="tag-list">
            {profile.languages.map((language) => <span>{language}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section id="education" class="section">
      <div class="degrees">
        <div>
          <p class="eyebrow">Education</p>
          <h2>Degrees</h2>
        </div>
        <div class="timeline">
          {industryEducation.map((item) => (
            <article class="timeline-item compact">
              <p class="period">{item.period}</p>
              <h3>{item.degree}</h3>
              <p class="meta">{item.school} · {item.location}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="section contact-section">
      <p class="eyebrow">Contact</p>
      <h2>Let's talk</h2>
      <p>{industryProfile.lookingFor} The quickest way to reach me is email.</p>
      <div class="hero-actions">
        <a class="button primary" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button" href={industryProfile.resume}>Resume (PDF)</a>
        <a class="button" href={profile.linkedin}>LinkedIn</a>
      </div>
    </section>

    <footer class="footer">
      <p>Farès Zaghouane</p>
      <div>
        <a href={profile.github}>GitHub</a>
        <a href={profile.linkedin}>LinkedIn</a>
      </div>
    </footer>
  </main>
</BaseLayout>
