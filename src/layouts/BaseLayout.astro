---
const {
  title = 'Farès Zaghouane',
  robots,
  path = '/',
  ogTitle = 'Farès Zaghouane — Machine Learning Research Engineer',
  description = 'I work on the predictor of JEPA world models: the module that moves a latent state forward in time, and the one whose behavior shapes whether planning on top of it holds up. Research internships at Nokia Bell Labs and Apple.',
  knowsAbout = [
    'World models',
    'JEPA predictors',
    'Representation learning',
    'Computer vision',
    'Reinforcement learning',
    'State-space models',
    'Koopman-style spectral constraints',
    'Formal verification',
  ],
} = Astro.props;

const canonicalUrl = new URL(path, 'https://fareszzz.github.io').href;
const ogDescription = description;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Farès Zaghouane',
  url: canonicalUrl,
  email: 'zaghouane.fares@gmail.com',
  sameAs: [
    'https://github.com/faresZzz',
    'https://www.linkedin.com/in/fares-zaghouane',
  ],
  alumniOf: [
    { '@type': 'EducationalOrganization', name: 'EPFL' },
    { '@type': 'EducationalOrganization', name: 'CPE Lyon' },
  ],
  knowsAbout,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={ogDescription} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={jsonLd} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
